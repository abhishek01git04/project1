#!/bin/bash
#PBS -N tc-head-reals
#PBS -q gpu
#PBS -l select=1:ncpus=6:ngpus=0:mem=16gb
#PBS -l walltime=04:00:00
#PBS -j oe

# CLIP features of the extra real photos for the TruthChain image head. Submit from the folder that holds
# image_head_job.py and image_head_features.py, after `python image_head_job.py download-reals`.
cd "$PBS_O_WORKDIR"
export CUDA_VISIBLE_DEVICES=0
export HF_HUB_OFFLINE=1
source /apps/anaconda3/bin/activate deeplearning
python -u image_head_job.py extract-reals > image-head-reals.log 2>&1
