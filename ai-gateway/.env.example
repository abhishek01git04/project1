# Copy to .env and adjust.

# Signing key of the gateway. Default = Hardhat account #1 (DEV ONLY, publicly known).
GATEWAY_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# auto = use Hugging Face models if installed, else heuristics | heuristic = always heuristics
DETECTOR_MODE=auto
# By default the gateway uses our own trained models from ../models (see training/README.md),
# preferring fine-tuned over from-scratch, and falls back to these Hub models. To force one:
# TEXT_MODEL=../models/text-baseline/model.joblib     # own TF-IDF model
# TEXT_MODEL=../models/text-distilbert                # own fine-tuned DistilBERT
# TEXT_MODEL=hamzab/roberta-fake-news-classification  # pretrained, from Hugging Face
# Images: comma-separated; the most suspicious model decides.
# Default: abacusai/Smaug-AI-Image-Detector - general AI-generated image detector (any subject).
# IMAGE_MODEL=abacusai/Smaug-AI-Image-Detector
# IMAGE_MODEL=Ateeqq/ai-vs-human-image-detector          # alternative, faster, less accurate
# IMAGE_MODEL=abacusai/Smaug-AI-Image-Detector,../models/image-cnn/model.pt   # + own face model
# SMAUG_CROPS=1    # ~3x faster on CPU, slightly less accurate (default 3)
# Image forensics for uploaded images. Leave a path empty to turn that model off.
# UNIVFD_MODEL=../models/image-univfd/fc_weights.pth   # AI-image detector on CLIP ViT-L/14 (1.7 GB download)
# TRUFOR_MODEL=../models/image-trufor/trufor.pth.tar   # local edits + heatmap; nonprofit use only
# TRUFOR_MAX_SIDE=1280                                 # larger images are reduced first
# IMAGE_FUSION_FILE=../models/image-fusion/calibration.json   # written by training/fit_image_fusion.py

# Synthetic-voice detector (Hugging Face audio-classification model)
# AUDIO_MODEL=MelodyMachine/Deepfake-audio-detection-V2
# Video: frames sampled per clip and scored with the image models (more = slower, more thorough)
# VIDEO_FRAMES=6

MAX_UPLOAD_MB=15
MAX_VIDEO_MB=100

# ---- Internet Evidence Engine (all optional; sources without a key are skipped)
# EVIDENCE_MODE=on                 # off = no web lookups (offline demos)
# NEWS_ENGINE=gdelt               # gdelt (free, no key) | newsapi (needs NEWSAPI_KEY)
# NEWSAPI_KEY=
# GDELT_TIMESPAN=3m               # how far back GDELT searches: 1w, 1m, 3m
# GOOGLE_NEWS_FALLBACK=on         # free Google News RSS search when GDELT is rate-limited or finds nothing
# GNEWS_LANG=en-IN
# GNEWS_REGION=IN
# GDELT_COOLDOWN=60               # seconds to pause GDELT after it rate-limits this IP
# ARTICLE_SEARCH=on                # find direct article links (Bing News RSS, free) so the AI reads full articles
# RETRIEVE_ARTICLES=4             # GDELT articles downloaded and read by Claude per claim
# GOOGLE_FACTCHECK_KEY=            # Google Fact Check Tools API (console.cloud.google.com)
# GOOGLE_VISION_KEY=               # Cloud Vision API key - enables reverse image search
# SOURCE_RATINGS_FILE=ratings.json # extra/override domain trust scores {"example.com": 0.8}
# Sent when fetching articles for /verify-url. Wikipedia and some others require contact details:
# FETCH_USER_AGENT=Mozilla/5.0 (compatible; TruthChain-Verifier/1.0; +https://your-site.example; you@example.com)

# ---- LLM evidence reasoning (optional): an AI model reads the articles GDELT found and judges each claim.
# Free: install Ollama (ollama.com) and run `ollama pull qwen2.5:7b` - used automatically when no Anthropic key is set.
# LLM_PROVIDER=auto                # auto = Claude if ANTHROPIC_API_KEY is set, else local Ollama | ollama | anthropic
# OLLAMA_MODEL=qwen2.5:7b          # needs ~8 GB RAM; qwen2.5:3b is faster but much more hesitant with the default prompt
# OLLAMA_URL=http://127.0.0.1:11434
# LLM_PROMPT_VERSION=v3            # v3 adds the date and a stricter "refuted" rule; v2 = earlier wording
# OLLAMA_TIMEOUT=240
# OLLAMA_MAX_TOKENS=600           # cap on the local model's answer length
# LLM_LOCAL_TRUST=0.6              # weight of the local model's verdict relative to Claude's (1.0)
# Paid alternative (better reasoning): Claude.
# Needs an Anthropic API key (console.anthropic.com). Skipped when not set.
# ANTHROPIC_API_KEY=
# LLM_REASONING=on                 # off = skip this step
# CLAUDE_MODEL=claude-opus-5-5
# LLM_RETRIEVAL=gdelt             # gdelt = read GDELT articles (no search fees) | web_search = Claude searches itself
# LLM_EFFORT=medium                # low | medium | high | xhigh | max
# LLM_WEB_FALLBACK=on             # while GDELT is rate-limited, Claude runs its own web search (billed)
# LLM_MAX_SEARCHES=5               # only for LLM_RETRIEVAL=web_search (each search is billed)

# Verification reports (JSON) are stored here and served at /reports/{hash}
# REPORTS_DIR=reports              # use /tmp/reports on Vercel (read-only filesystem)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
